{
	"$schema": "node_modules/wrangler/config-schema.json",

	// Worker name = the service name in Cloudflare. Pulumi's WorkersCustomDomain
	// resources reference this exact string (gtmxsite:workerName), so renaming it
	// here means renaming it in the Pulumi stack config too — and the script must
	// exist before a custom domain can attach to it.
	"name": "gtmx-agents-site",

	// wrangler bundles TypeScript natively — no separate build step for the Worker.
	// `pnpm build` only produces the static assets in ./dist.
	"main": "worker/index.ts",

	// Pins the workerd runtime behaviour to the semantics that existed on this
	// date. Bumping it opts into newer (possibly breaking) runtime defaults, so it
	// is a deliberate, reviewed change — not something to refresh casually.
	"compatibility_date": "2026-08-17",

	// workers.dev URL stays on: it is how we smoke-test a deploy before DNS is
	// attached, and it is the host for PR preview aliases.
	"workers_dev": true,
	// Per-version preview URLs — required for `wrangler versions upload
	// --preview-alias pr-<n>` in CI to hand back a reviewable URL with zero
	// production impact.
	"preview_urls": true,

	// Logs + traces in the Cloudflare dashboard. Free and the only way to debug a
	// production 500 in a Worker after the fact.
	"observability": {
		"enabled": true
	},

	// Waitlist storage for POST /api/waitlist (worker/waitlist.ts).
	//
	// D1, not the product's Postgres: marketing data and application data have no
	// reason to share a database, and this repo's rule is that product logic stays
	// out of the marketing site. A native binding also means the Worker holds no
	// credential — nothing to `wrangler secret put`, nothing to rotate, and a
	// compromised marketing site cannot reach the product database.
	//
	// COMMENTED OUT DELIBERATELY. A d1_databases entry with a placeholder
	// database_id fails `wrangler deploy`, and an id for a database that does not
	// exist deploys and then throws at runtime. Until it is created the binding is
	// absent and the handler answers 503, which is the honest state.
	//
	// To turn the waitlist on (one time):
	//   pnpm -C site exec wrangler d1 create gtmx-agents-site
	//        -> paste the printed database_id below and uncomment
	//   pnpm -C site exec wrangler d1 migrations apply gtmx-agents-site --remote
	//
	// "d1_databases": [
	//   {
	//     "binding": "WAITLIST_DB",
	//     "database_name": "gtmx-agents-site",
	//     "database_id": "<id printed by d1 create>",
	//     "migrations_dir": "migrations"
	//   }
	// ],

	"assets": {
		// Must match vite.config.ts `build.outDir`.
		"directory": "./dist",
		// Binding name used in worker/index.ts as `env.ASSETS`.
		"binding": "ASSETS",
		// Deep links (/nope/deep) return index.html with a 200 instead of a 404.
		// NOTE: with real routes now present (product/, company/, contact/), this
		// only applies to paths that match no entry — a genuine 404 is still
		// answered with the home page, which is why /typo renders the home page
		// rather than an error. Acceptable for a marketing site; revisit if a
		// real 404 page is ever wanted.
		"not_found_handling": "single-page-application",

		// Serve /product directly rather than 307-ing to /product/.
		//
		// The default ("auto-trailing-slash") redirects /product -> /product/,
		// which contradicts the canonical tag and the sitemap entry, both of
		// which declare the slash-less form. That mismatch makes a crawler follow
		// a redirect to a page whose canonical points back at the URL it was just
		// redirected from. Dropping the slash makes the served URL, the canonical
		// and the sitemap all agree on one spelling.
		"html_handling": "drop-trailing-slash",
		// MUST stay an ARRAY of path globs. `true` sends EVERY request — including
		// hashed assets — through the Worker, which meters requests that would
		// otherwise be free/unmetered. If a wrangler version rejects the array
		// form, upgrade wrangler; never "fix" this by setting true.
		//
		// Consequence to know about: anything NOT matched here never reaches
		// worker/index.ts. That includes every document request, which is why the
		// www→apex 301 in the Worker currently only fires for /api/* — see the
		// KNOWN GAP comment in worker/index.ts. If that redirect must work, the
		// fix is negative patterns (["/*", "!/assets/*"]), which keeps hashed
		// assets unmetered while letting documents through — NOT `true`.
		"run_worker_first": ["/api/*"]
	}
}
