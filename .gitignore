# Dependencies — pnpm store is global; the local tree is disposable.
node_modules/

# Build output. `site/dist` is what wrangler uploads as static assets; it is
# always regenerated by `pnpm build`, never committed (hashed filenames would
# churn the diff on every build).
dist/

# wrangler's local state: miniflare caches, dev KV/D1 sqlite, session temp dirs.
.wrangler/

# Turborepo cache. No turbo.json yet (single package) — ignored ahead of time so
# adding Turborepo later can't leak a cache dir into a commit.
.turbo/

# Pulumi/Go build artifacts land here (infra/ workstream).
bin/

*.log

# Local secrets: .env, .env.local, .env.production … Cloudflare secrets live in
# `wrangler secret` / GitHub Actions secrets, Pulumi secrets in the stack config.
.env*

.DS_Store
